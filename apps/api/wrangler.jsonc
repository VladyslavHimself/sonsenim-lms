{
  "name": "sonsenim-api",
  "main": "./worker.ts",
  "compatibility_date": "2026-02-05",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "vars": {},

  "env": {
    "staging": {
      "name": "sonsenim-api",
      "vars": {
        "APP_ENV": "staging"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "35c32e963c7a43fc807e4fabad65947b"
        }
      ],
      "routes": [
        {
          "pattern": "staging.api.sonsennim.com/*",
          "zone_name": "sonsennim.com"
        }
      ]
    },

    "production": {
      "name": "sonsenim-api",
      "vars": {
        "APP_ENV": "production"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "7db77ce347b5473a87a95ec176c61274"
        }
      ],
      "routes": [
        { "pattern": "api.sonsennim.com/*", "zone_name": "sonsennim.com" }
      ]
    }
  }
}
